{
  "name": "kingdom-sound-radio",
  "version": "0.1.0",
  "private": true,
  "description": "The Kingdom Sound Radio — broadcasting and media platform (preview build)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
