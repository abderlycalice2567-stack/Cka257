    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
