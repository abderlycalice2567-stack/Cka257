# ---- Core ----
# Public base URL (used for canonical links, RSS feeds, email links)
APP_URL=http://localhost:3000
# PostgreSQL connection string (Supabase: use the pooled connection string)
DATABASE_URL=postgres://ksr:ksr_dev_only@localhost:5432/ksr
# Separate database for automated tests (never point at production)
TEST_DATABASE_URL=postgres://ksr:ksr_dev_only@localhost:5432/ksr_test
# Local media storage directory (production: replace with S3/R2 adapter)
MEDIA_DIR=./data/media
# Set to "true" only in production once the site should be indexed
ALLOW_INDEXING=false

# ---- Email (optional; without it, links are written to the server log) ----
RESEND_API_KEY=
EMAIL_FROM="The Kingdom Sound Radio <no-reply@example.org>"

# ---- Payments (optional; without it, giving is shown as "not connected") ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Bootstrap admin (used by `npm run admin:create`) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Security ----
# 32+ random characters; encrypts MFA secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
APP_SECRET=
# Shared secret for the broadcasting-engine webhook (optional)
RADIO_WEBHOOK_SECRET=
