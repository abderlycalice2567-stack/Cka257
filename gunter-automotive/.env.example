# Copy to .env.local for local development. Never commit real values.
# With no SUPABASE_* values the site runs in DEMO MODE: the form validates
# but nothing is stored or sent, and the receipt page says so.

# Public base URL (canonical URLs, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "preview" (default): private demo, noindex, draft content labelled.
# "live": ONLY after written owner sign-off. Read at BUILD time, so rebuild after changing it.
SITE_MODE=preview

# HTTP Basic Auth for private previews (ignored when SITE_MODE=live).
PREVIEW_USERNAME=
PREVIEW_PASSWORD=

# Supabase (server-only). Use separate projects for preview and production.
# The service-role key bypasses RLS: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email (server-only).
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend.
LEAD_NOTIFY_FROM="Gunter Automotive Website <requests@example.com>"
# Comma-separated. In the private demo use TEST recipients only, never the owner or customers.
LEAD_NOTIFY_TO=
