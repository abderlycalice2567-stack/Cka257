# ----------------------------------------------------------------------------
# Jona Radio — redesign PROPOSAL (proof of concept). Copy to `.env.local`.
# No secrets are committed to the repository. See docs/SECURITY.md.
# ----------------------------------------------------------------------------

# Public base URL of the PREVIEW deployment (used for canonical/OG metadata).
# Example only — this is NOT the official jonaradio.net domain.
NEXT_PUBLIC_SITE_URL=https://jona-radio-preview.example-agency.com

# Live stream endpoint for the demo player.
# The station's publicly published HTTPS Zeno.fm mount may be used for the demo
# ONLY if its use is permitted. Otherwise set a licensed demonstration source,
# or leave blank to run the player in clearly-labelled "offline demo" mode.
# The player NEVER claims "live" unless the <audio> element actually connects.
NEXT_PUBLIC_STREAM_URL=
# Optional now-playing metadata endpoint (HTTPS). Leave blank to disable.
NEXT_PUBLIC_STREAM_METADATA_URL=

# ---- Preview access gate (F / section 11: keep the preview restricted) ------
# When PREVIEW_AUTH_ENABLED=true, HTTP Basic Auth protects every route.
# Set these ONLY in the host's environment settings, never in code.
PREVIEW_AUTH_ENABLED=false
PREVIEW_AUTH_USER=
PREVIEW_AUTH_PASSWORD=

# Set to "false" ONLY if you ever intend the preview to be indexable (not
# recommended for a speculative proposal). Default keeps it unindexed.
NEXT_PUBLIC_ALLOW_INDEXING=false
