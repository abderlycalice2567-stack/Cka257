# ---------------------------------------------------------------------------
# Lopez Auto Repair — environment variables
# Copy to .env.local for local development. Never commit real values.
# With the database variables left empty the site runs in DEMO MODE:
# the request form validates input but stores and sends nothing, and says so.
# ---------------------------------------------------------------------------

# Public base URL of this deployment (used for canonical URLs and the sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Preview protection -----------------------------------------------------
# When set, every page requires HTTP Basic auth (any username, this password).
# Keep this set on every deployment until the owner signs off in writing.
PREVIEW_PASSWORD=

# Search-engine indexing. Leave unset/false for previews. Set to "true" ONLY
# on the production deployment after written owner approval (Phase 4).
ALLOW_INDEXING=false

# --- Lead storage (Supabase Postgres, server-only) --------------------------
# Use a separate Supabase project for preview and production.
SUPABASE_URL=
# Service-role key: server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Lead notification email (Resend) ---------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "Website requests <requests@example.com>"
EMAIL_FROM=
# Recipient of new-request notifications. In the private demo this must be a
# TEST recipient — never the business or a customer without owner approval.
LEAD_NOTIFY_TO=

# --- Scheduled notification retry -------------------------------------------
# Bearer secret required by /api/cron/retry-notifications (Vercel Cron sends it).
CRON_SECRET=
