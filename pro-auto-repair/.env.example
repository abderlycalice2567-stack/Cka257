# ---------------------------------------------------------------------------
# Pro Auto Repair — environment variables
# Copy to .env.local. Never commit real values. Never prefix secrets with NEXT_PUBLIC_.
# With no backend variables set, the site runs in clearly labeled DEMO MODE:
# the request form validates input but stores and sends nothing.
# ---------------------------------------------------------------------------

# "preview" (default): noindex everywhere, preview banner, robots.txt disallows all.
# "production": only after written owner approval (see docs/DEPLOYMENT_CHECKLIST.md).
SITE_MODE=preview

# Public origin, used for canonical URLs and the sitemap.
SITE_URL=http://localhost:3000

# Optional HTTP Basic auth gate for the preview. Set both to enable.
PREVIEW_USERNAME=
PREVIEW_PASSWORD=

# --- Lead storage (Supabase Postgres, server-only) --------------------------
SUPABASE_URL=
# Service-role key: server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Lead notification email (Resend) ---------------------------------------
RESEND_API_KEY=
# Verified sender, e.g. "Website requests <requests@example.com>"
LEAD_NOTIFY_FROM=
# Authorized recipient. In preview this must be a TEST inbox, not the owner or a customer.
LEAD_NOTIFY_TO=
