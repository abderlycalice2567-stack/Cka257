# Copy to .env.local for development. Never commit real values.
# With SUPABASE_* unset the site runs in DEMO MODE: the form validates but
# nothing is stored or sent, and every screen says so.

# --- Public site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep "true" (shows prototype notices, unapproved services) until owner sign-off.
NEXT_PUBLIC_PROTOTYPE=true
# Only set to "true" at owner-approved launch. Otherwise every page is noindex
# and robots.txt disallows all crawling.
ALLOW_INDEXING=false

# --- Private preview gate (HTTP Basic auth on every page and API route) -------
# Set on all preview deployments. Remove only after written owner sign-off.
PREVIEW_USER=preview
PREVIEW_PASSWORD=

# --- Lead storage: Supabase (server-only) --------------------------------------
SUPABASE_URL=
# Service-role key: bypasses RLS. Server-side env only — never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner notification email: Resend ----------------------------------------
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend.
EMAIL_FROM="Website Requests <requests@example.com>"
# Comma-separated. Private demo: TEST RECIPIENTS ONLY, never the owner or customers.
LEAD_NOTIFY_TO=

# --- Scheduled notification retry (/api/cron/notify) --------------------------
# Vercel sends "Authorization: Bearer $CRON_SECRET" automatically when set.
CRON_SECRET=
